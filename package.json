{
  "name": "lockfilelens",
  "version": "0.1.0",
  "description": "Local dependency lockfile diff explainer for PR and agent handoff reviews.",
  "type": "module",
  "bin": {
    "lockfilelens": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run build -- --quiet && node --test",
    "build": "tsc && node scripts/make-cli-executable.mjs",
    "smoke": "bash scripts/smoke.sh"
  },
  "keywords": [
    "dependencies",
    "lockfile",
    "review",
    "agents",
    "cli"
  ],
  "author": "StackForge User",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
